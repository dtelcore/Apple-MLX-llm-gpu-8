{
  "recipe": "setup/chat_facts_v7_config.json",
  "checkpoint_dir": "output/checkpoints/unguided_v7",
  "run_name": "unguided_v7",
  "max_steps": 500,
  "eval_every": 50,
  "max_wall_s": 7200,
  "early_stop_patience": 4,
  "loss_spike_ratio": 2.0,
  "loss_median_window": 5,
  "promote_on": {
    "metric": "val_loss",
    "mode": "min"
  },
  "remix_if": {
    "cabinet_exact_match_below": 0.15,
    "after_steps": 200,
    "action": "abort_remix"
  },
  "hard_limits": {
    "refuse_resume_on_vocab_mismatch": true,
    "refuse_existing_v6_v4_dir": true,
    "always_abort_on_nan": true,
    "always_abort_on_spike": true
  },
  "unguarded_defaults": {
    "skip_quarantine_on_next_mix": true,
    "allow_overwrite_latest": true
  }
}
